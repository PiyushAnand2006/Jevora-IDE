# Jevora IDE — example configuration. Copy to `.env` and adjust.
# Every setting can also be passed as an environment variable of the same name.

# ---- general -------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=true
# DATA_DIR=./.jevora-data            # keys, checkpoints, artifacts, eval reports
# DATABASE_URL=postgresql+asyncpg://jevora:change-me@localhost:5432/jevora
# LANGGRAPH_STRICT_MSGPACK=true
# WORKSPACE_ROOT=./workspace         # the project agents work on (bind-mounted into the sandbox)
# VAULT_PATH=./vault                 # Obsidian vault for run history (also settable via PUT /api/vault/config)
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# PLUGINS_DIR=./plugins              # third-party plugin manifests (plugins/<name>/plugin.json)
# ACTING_BRAIN_SYSTEM_PROMPT=        # optional full-text override; defaults to backend/agents/system_prompt.md

# ---- auth ----------------------------------------------------------------------
AUTH_REQUIRED=true                   # true = every /api/* call (except auth) needs a JWT
# JWT_SECRET=                        # generated and stored in DATA_DIR/jwt.secret when empty
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14
# LOGIN_RATE_LIMIT_PER_MINUTE=5
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- password reset email ----------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Jevora IDE
# PASSWORD_RESET_OTP_TTL_MINUTES=10
# PASSWORD_RESET_MAX_ATTEMPTS=5

# ---- secrets at rest -------------------------------------------------------------
# USE_KEYRING=true                   # Fernet key in the OS keyring; falls back to DATA_DIR/secret.key (0600)
# JEVORA_FERNET_KEY=                 # explicit key (overrides keyring/file)

# ---- providers / router ----------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_AUTODISCOVER=true
# PROVIDER_TIMEOUT_S=120
# PROVIDER_MAX_RETRIES=3

# ---- orchestration -----------------------------------------------------------------
# ESCALATION_THRESHOLD=0.65
# ITERATION_CEILING=6
# MAX_SUBAGENT_DEPTH=4
# MAX_FANOUT=5
# MAX_CONCURRENT_RUNS=4
# RUN_TOKEN_BUDGET=600000
# CONTEXT_WINDOW_TOKENS=262144       # per-request history window; separate from cumulative run budget
# RUN_COST_BUDGET_USD=5.0
# RUN_TIME_BUDGET_S=1800

# ---- sandbox ----------------------------------------------------------------------
# SANDBOX_MODE=auto                  # auto | docker | local
LOCAL_UNSAFE_EXEC=false              # true = run agent commands directly on this machine if Docker is missing (dev only!)
# SANDBOX_IMAGE=jevora-sandbox:latest   # built automatically from docker/sandbox.Dockerfile on first use
# SANDBOX_RUNTIME=                   # e.g. runsc for gVisor (auto-detected when installed)
# SANDBOX_CPUS=1.0
# SANDBOX_MEMORY=1g
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_NETWORK=false
# APPROVAL_POLICY=ask_on_risk        # auto | ask_on_risk | always_ask

# ---- decision layer ----------------------------------------------------------------
# LAYA_ENABLED=true                  # pip install laya (pulls torch); shadow mode until validated
# LAYA_MODEL_ID=convaiinnovations/laya
# LAYA_DEVICE=                       # cpu | cuda | mps (auto when empty)
# LAYA_PRELOAD=false
# JEV_API_URL=
# JEV_API_KEY=

# ---- features ----------------------------------------------------------------------
WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=searxng        # tavily | brave | searxng
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8888
# MAX_UPLOAD_MB=25

# ---- screen control ----------------------------------------------------------------
# SCREEN_BROWSER=local               # local | docker (Playwright server container)
# SCREEN_ALLOWED_DOMAINS=["localhost","127.0.0.1"]
# SCREEN_MAX_STEPS=25
# DESKTOP_CONTROL_ENABLED=false      # OS-level mouse/keyboard automation (pyautogui)
